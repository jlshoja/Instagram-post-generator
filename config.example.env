# Copy to .env and fill in real values. Never commit .env.
BASE_URL=https://bazarkif.org
SHOP_URL=https://bazarkif.org/shop/

# Storage
# DB_PATH=./data/bazarkif.db
# MEDIA_ROOT=./.media

# Scheduling (minutes) — change frequency here, no code change needed
SCAN_INTERVAL_MINUTES=1440
ENABLE_SCHEDULER=1

# HTTP / concurrency
REQUEST_TIMEOUT=30
REQUEST_DELAY=0.5
WORKERS=4
CONCURRENCY_DOWNLOAD=4
# SAMPLE_LIMIT=3   # >0: process only this many products (test mode; unset = all)

# Retry
MAX_ATTEMPTS=5
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=300
RETRY_FACTOR=2

# Media optimization
WEBP_TARGET_BYTES=128000
IMAGE_MAX_DIMENSION=1080

# Pricing: benefit % added to the base price before publishing
# PRICING_FILE=./data/mapping/pricing_sample.csv
# PRICING_ENABLED=1   # 0 = publish base prices

# Telegram (required to publish)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_PENDING=
TELEGRAM_THREAD_PUBLISHED=
TELEGRAM_THREAD_CHANGES=
TELEGRAM_THREAD_FAILED=

LOG_LEVEL=INFO